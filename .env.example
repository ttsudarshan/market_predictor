# Copy this file to .env and fill in YOUR OWN key(s). .env is git-ignored.
# You only need ONE of these. Without any key, trading still works; only YouTube prediction reading is off.

# Google Gemini (has a free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic Claude (paid, billed by usage): https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: force a provider when both keys are set (Gemini or Anthropic)
# Llm__Provider=Gemini

# Optional: cheaper Claude model
# Llm__Model=claude-haiku-5-5
